{
  "name": "tdxl-english-prep",
  "private": true,
  "version": "1.7.3",
  "type": "module",
  "description": "同等学力申硕英语备考 PWA + Windows 桌面版（单用户、离线优先、三端适配）",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:ico": "node scripts/gen-ico.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop && node scripts/build-electron.mjs && node scripts/gen-ico.mjs && electron-builder --win",
    "start:desktop": "vite build --mode desktop && node scripts/build-electron.mjs && electron ."
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "koffi": "^3.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.0",
    "workbox-window": "^7.3.0"
  }
}
