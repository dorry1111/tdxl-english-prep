ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata

# 本地配置 / 备份（含敏感凭据，禁止提交）
*.local.json
*.bak

# 原始语料 / 开发期数据（非构建所需，体积大，勿提交到仓库）
